{
  "configurations": [
    {
      "name": "msdebug",
      "type": "msdebug-mi",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "target": "${workspaceFolder}/build/${workspaceFolderBasename}",
      "environmentScripts": [
        "${workspaceFolder}/.vscode/.env"
      ]
    },
    {
      "name": "remote-debug",
      "type": "msdebug-mi-remote",
      "request": "launch",
      "cwd": "${remoteWorkspaceFolder}",
      "target": "${remoteWorkspaceFolder}/build/${workspaceFolderBasename}",
      "remoteConfig": {
        "host": "",
        "port": 55555,
        "remoteWorkspaceFolder": "d:\\base\\TVSOS"
      },
      "environmentScripts": [
        "${workspaceFolder}/.vscode/.env"
      ]
    },
    {
      "name": "msdebug-cpu",
      "type": "msdebug-mi",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "target": "${workspaceFolder}/build/${workspaceFolderBasename}",
      "msdebugMiPath": "/usr/bin/gdb",
      "environmentScripts": [
        "${workspaceFolder}/.vscode/.env"
      ]
    },
    {
      "name": "msdebug-python",
      "type": "msdebug-mi",
      "request": "launch",
      "cwd": "${workspaceRoot}/build",
      "target": "/usr/local/bin/python",
      "targetArgs": [
        "${workspaceFolder}/run.py"
      ],
      "environmentScripts": [
        "${workspaceFolder}/.vscode/.env"
      ],
      "skipEnvCheck": true
    },
    {
      "name": "msdebug-triton-npu",
      "type": "msdebug-mi",
      "request": "launch",
      "cwd": "${workspaceRoot}",
      "target": "/usr/bin/python3",
      "targetArgs": [
        "${workspaceFolder}/op.py"
      ],
      "environmentScripts": [
        "${workspaceFolder}/.vscode/.env"
      ]
    }
  ]
}